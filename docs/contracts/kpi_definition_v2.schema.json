{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reclassifier.local/contracts/kpi_definition_v2.schema.json",
  "title": "Reclassifier KPI Definition V2 metadata, non-executable",
  "description": "Read-only projection of existing KPI Catalog and Calculation Contract. Not an executable formula and not an approval of methodology.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kpiId",
    "identity",
    "measurement",
    "calculator",
    "data",
    "components",
    "relatedMetrics",
    "forecast",
    "presentation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "kpiId": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "visibleInReport"
      ],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "visibleInReport": {
          "type": "boolean"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "unit"
      ],
      "properties": {
        "kind": {
          "enum": [
            "unconfigured",
            "count",
            "sum",
            "ratio",
            "coefficient",
            "custom"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "calculator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integration",
        "handlerRef",
        "formulaVersion",
        "calculationContractVersion",
        "contractRef"
      ],
      "properties": {
        "integration": {
          "enum": [
            "existing-calculator",
            "not-implemented"
          ]
        },
        "handlerRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "formulaVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "calculationContractVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "contractRef": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRefs",
        "filterDimensions",
        "periodGrain"
      ],
      "properties": {
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "datasetId",
              "semanticFields"
            ],
            "properties": {
              "datasetId": {
                "type": "string",
                "minLength": 1
              },
              "semanticFields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "filterDimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "periodGrain": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "unit",
          "role",
          "valuePath"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "numerator",
              "denominator",
              "context"
            ]
          },
          "valuePath": {
            "type": "string",
            "pattern": "^components\\.[a-zA-Z][a-zA-Z0-9]*$"
          }
        }
      }
    },
    "relatedMetrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "componentKey",
          "presentation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "componentKey": {
            "type": "string",
            "minLength": 1
          },
          "presentation": {
            "const": "defined-not-connected"
          }
        }
      }
    },
    "forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "methodIds",
        "chartNowcastConnected",
        "chartPresentation",
        "selectionSurface"
      ],
      "properties": {
        "policy": {
          "enum": [
            "none",
            "reporting-month-components",
            "reporting-month-volume",
            "historical-next-month"
          ]
        },
        "methodIds": {
          "type": "array",
          "items": {
            "enum": [
              "observed-run-rate",
              "last-value",
              "linear-trend"
            ]
          }
        },
        "chartNowcastConnected": {
          "type": "boolean"
        },
        "chartPresentation": {
          "enum": [
            "percentage-month-endpoint",
            "absolute-current-to-month-end",
            "no-reporting-month-overlay"
          ]
        },
        "selectionSurface": {
          "enum": [
            "none",
            "kpi-chart",
            "operational-chart"
          ]
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passport",
        "card",
        "chart",
        "pdf",
        "visualStyle"
      ],
      "properties": {
        "passport": {
          "const": "shared-four-tabs"
        },
        "card": {
          "enum": [
            "hidden",
            "existing",
            "placeholder"
          ]
        },
        "chart": {
          "enum": [
            "hidden",
            "existing-line-svg",
            "not-implemented"
          ]
        },
        "pdf": {
          "enum": [
            "existing-snapshot-renderer",
            "not-implemented"
          ]
        },
        "visualStyle": {
          "const": "unchanged"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "calculator": {
            "properties": {
              "integration": {
                "const": "not-implemented"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "measurement": {
            "properties": {
              "kind": {
                "const": "unconfigured"
              }
            }
          },
          "data": {
            "properties": {
              "sourceRefs": {
                "maxItems": 0
              },
              "filterDimensions": {
                "maxItems": 0
              },
              "periodGrain": {
                "type": "null"
              }
            }
          },
          "components": {
            "maxItems": 0
          },
          "relatedMetrics": {
            "maxItems": 0
          },
          "forecast": {
            "properties": {
              "policy": {
                "const": "none"
              },
              "methodIds": {
                "maxItems": 0
              },
              "chartNowcastConnected": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "forecast": {
            "properties": {
              "policy": {
                "const": "none"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "forecast": {
            "properties": {
              "chartNowcastConnected": {
                "const": false
              },
              "selectionSurface": {
                "const": "none"
              }
            }
          }
        }
      }
    }
  ]
}
