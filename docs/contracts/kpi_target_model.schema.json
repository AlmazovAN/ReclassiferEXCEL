{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reclassifier KPI Target Model 1.0.0 — illustrative bundle",
  "description": "Design-time schema only; not a runtime persistence change or approved KPI methodology.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "modelVersion",
    "documentType",
    "exampleOnly",
    "definition",
    "calculation",
    "result",
    "series",
    "trace",
    "card"
  ],
  "properties": {
    "modelVersion": {
      "const": "1.0.0"
    },
    "documentType": {
      "const": "kpi-target-model-bundle"
    },
    "exampleOnly": {
      "type": "boolean"
    },
    "definition": {
      "$ref": "#/$defs/definition"
    },
    "calculation": {
      "$ref": "#/$defs/calculation"
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "series": {
      "$ref": "#/$defs/series"
    },
    "trace": {
      "$ref": "#/$defs/trace"
    },
    "card": {
      "$ref": "#/$defs/card"
    }
  },
  "$defs": {
    "fieldRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetId",
        "field"
      ],
      "properties": {
        "datasetId": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "sourceColumn": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "metricState": {
      "enum": [
        "available",
        "no-data",
        "unavailable",
        "insufficient",
        "not-applicable",
        "error"
      ]
    },
    "numberOrNull": {
      "type": [
        "number",
        "null"
      ]
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "definition",
        "purpose",
        "unit",
        "direction",
        "methodology",
        "target"
      ],
      "properties": {
        "fullTitle": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable expanded KPI title. Optional for backward-compatible definition bundles."
        },
        "limitation": {
          "type": ["string", "null"],
          "description": "Reader-facing methodological caveat, if relevant."
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "higher-is-better",
            "lower-is-better",
            "target-range",
            "neutral"
          ]
        },
        "methodology": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "status",
            "reference"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "draft",
                "approved",
                "retired"
              ]
            },
            "reference": {
              "type": [
                "string",
                "null"
              ]
            },
            "effectiveFrom": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            }
          }
        },
        "target": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "comparison"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "comparison": {
                  "enum": [
                    "gte",
                    "lte",
                    "equal",
                    "between"
                  ]
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetId",
        "grain",
        "fields"
      ],
      "properties": {
        "datasetId": {
          "type": "string",
          "minLength": 1
        },
        "grain": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "purpose",
              "nullPolicy"
            ],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "sourceColumn": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "nullPolicy": {
                "enum": [
                  "exclude",
                  "preserve",
                  "unavailable",
                  "not-applicable"
                ]
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "left",
        "right",
        "joinType",
        "cardinality",
        "onUnmatched",
        "onDuplicate"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "left": {
          "$ref": "#/$defs/fieldRef"
        },
        "right": {
          "$ref": "#/$defs/fieldRef"
        },
        "joinType": {
          "enum": [
            "INNER",
            "LEFT",
            "RIGHT",
            "FULL",
            "LOOKUP"
          ]
        },
        "cardinality": {
          "enum": [
            "1:1",
            "1:N",
            "N:1",
            "N:N"
          ]
        },
        "onUnmatched": {
          "enum": [
            "exclude",
            "preserve-null",
            "unavailable",
            "fail"
          ]
        },
        "onDuplicate": {
          "enum": [
            "fail",
            "deduplicate-by-key",
            "retain-with-justification"
          ]
        },
        "justification": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stage",
        "field",
        "operator",
        "value",
        "effect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "enum": [
            "source",
            "facts",
            "preparation",
            "query"
          ]
        },
        "field": {
          "$ref": "#/$defs/fieldRef"
        },
        "operator": {
          "enum": [
            "eq",
            "ne",
            "in",
            "not-in",
            "is-null",
            "not-null",
            "gte",
            "lte",
            "between"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "array",
            "null"
          ]
        },
        "effect": {
          "enum": [
            "include",
            "exclude"
          ]
        },
        "note": {
          "type": "string"
        },
        "appliesTo": {
          "type": [
            "string",
            "null"
          ],
          "description": "Component scope for numerator-only predicate; not a global WHERE."
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation",
        "inputs",
        "output",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "FILTER",
            "JOIN",
            "MAP",
            "GROUP",
            "COUNT",
            "COUNT_DISTINCT",
            "SUM",
            "ADD",
            "SUBTRACT",
            "MULTIPLY",
            "DIVIDE",
            "ROUND",
            "IDENTITY",
            "CUSTOM"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "handlerRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grain",
        "componentMethods",
        "combinePeriods",
        "missingPolicy"
      ],
      "properties": {
        "grain": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "componentMethods": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": [
              "SUM",
              "COUNT",
              "COUNT_DISTINCT",
              "FIRST_VALID",
              "CUSTOM"
            ]
          }
        },
        "combinePeriods": {
          "enum": [
            "sum-components-then-formula",
            "sum-values",
            "weighted-average",
            "not-supported"
          ]
        },
        "missingPolicy": {
          "enum": [
            "block",
            "skip-with-diagnostic",
            "explicit-zero-only"
          ]
        }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "periodGrain",
        "basis",
        "incompletePeriod",
        "historicalSupported",
        "previous",
        "rolling",
        "forecast"
      ],
      "properties": {
        "periodGrain": {
          "const": "month"
        },
        "basis": {
          "$ref": "#/$defs/fieldRef"
        },
        "incompletePeriod": {
          "enum": [
            "exclude",
            "include-with-label",
            "unavailable-until-closed"
          ]
        },
        "historicalSupported": {
          "type": "boolean"
        },
        "previous": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selection",
            "whenMissing"
          ],
          "properties": {
            "selection": {
              "enum": [
                "previous-calendar-period",
                "previous-equivalent-range"
              ]
            },
            "whenMissing": {
              "const": "null-with-reason"
            }
          }
        },
        "rolling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "defaultWindow",
            "minWindow",
            "requireCompleteWindow"
          ],
          "properties": {
            "method": {
              "enum": [
                "ratio-of-sums",
                "sum",
                "average",
                "unavailable"
              ]
            },
            "defaultWindow": {
              "type": "integer",
              "minimum": 2
            },
            "minWindow": {
              "type": "integer",
              "minimum": 2
            },
            "requireCompleteWindow": {
              "const": true
            }
          }
        },
        "forecast": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "methodId",
            "horizon",
            "minPeriods"
          ],
          "properties": {
            "status": {
              "enum": [
                "not-defined",
                "draft",
                "approved"
              ]
            },
            "methodId": {
              "type": [
                "string",
                "null"
              ]
            },
            "horizon": {
              "type": [
                "string",
                "null"
              ]
            },
            "minPeriods": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "currentMonthForecast": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "methodId",
            "methodVersion",
            "horizon",
            "minHistoryMonths",
            "validationMonths",
            "populationBasis",
            "note"
          ],
          "properties": {
            "status": { "const": "experimental" },
            "methodId": { "const": "monthly-components-remaining-days" },
            "methodVersion": { "type": "string", "minLength": 1 },
            "horizon": { "const": "end-of-current-calendar-month" },
            "minHistoryMonths": { "type": "integer", "minimum": 6 },
            "validationMonths": { "type": "integer", "minimum": 2 },
            "populationBasis": { "const": "fixed-drivers-reference" },
            "note": { "type": "string", "minLength": 1 }
          }
        },
        "periodBindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "datasetId",
              "field",
              "purpose"
            ],
            "properties": {
              "datasetId": {
                "type": "string",
                "minLength": 1
              },
              "field": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kpiId",
        "contractVersion",
        "status",
        "sources",
        "joins",
        "filters",
        "steps",
        "aggregation",
        "temporal",
        "formula",
        "preparationHandler",
        "formulaHandler",
        "sourceComponents"
      ],
      "properties": {
        "kpiId": {
          "type": "string",
          "minLength": 1
        },
        "contractVersion": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "draft",
            "approved"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        },
        "joins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/join"
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/filter"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1
        },
        "aggregation": {
          "$ref": "#/$defs/aggregation"
        },
        "temporal": {
          "$ref": "#/$defs/temporal"
        },
        "formula": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expression",
            "formulaVersion",
            "output",
            "zeroDenominator",
            "roundingDigits"
          ],
          "properties": {
            "expression": {
              "type": "string",
              "minLength": 1
            },
            "formulaVersion": {
              "type": "string",
              "minLength": 1
            },
            "output": {
              "type": "string",
              "minLength": 1
            },
            "zeroDenominator": {
              "enum": [
                "unavailable",
                "not-applicable"
              ]
            },
            "roundingDigits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            }
          }
        },
        "preparationHandler": {
          "type": "string",
          "minLength": 1
        },
        "formulaHandler": {
          "type": "string",
          "minLength": 1
        },
        "sourceComponents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value",
        "unit",
        "dataState",
        "reason",
        "formulaVersion",
        "methodologyStatus",
        "components",
        "query",
        "sourceComponents",
        "diagnostics"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/numberOrNull"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "dataState": {
          "$ref": "#/$defs/metricState"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "formulaVersion": {
          "type": "string",
          "minLength": 1
        },
        "methodologyStatus": {
          "enum": [
            "draft",
            "approved",
            "retired"
          ]
        },
        "components": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/numberOrNull"
          }
        },
        "query": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "period",
            "filters"
          ],
          "properties": {
            "period": {
              "type": "string",
              "minLength": 1
            },
            "filters": {
              "type": "object"
            }
          }
        },
        "sourceComponents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "diagnostics": {
          "type": "object"
        }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kpiId",
        "grain",
        "slice",
        "points"
      ],
      "properties": {
        "kpiId": {
          "type": "string",
          "minLength": 1
        },
        "grain": {
          "const": "month"
        },
        "slice": {
          "type": "object"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "period",
              "value",
              "dataState",
              "reason",
              "components"
            ],
            "properties": {
              "period": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}$"
              },
              "value": {
                "$ref": "#/$defs/numberOrNull"
              },
              "dataState": {
                "$ref": "#/$defs/metricState"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "components": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/numberOrNull"
                }
              }
            }
          }
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kpiId",
        "snapshotRef",
        "query",
        "sources",
        "counts",
        "executions",
        "finalComponents",
        "output"
      ],
      "properties": {
        "kpiId": {
          "type": "string",
          "minLength": 1
        },
        "snapshotRef": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "object"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "datasetId",
              "revision",
              "contentHash"
            ],
            "properties": {
              "datasetId": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "contentHash": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "freshness": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "executions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stepId",
              "operation",
              "inputs",
              "output"
            ],
            "properties": {
              "stepId": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "minLength": 1
              },
              "inputs": {
                "type": "object"
              },
              "output": {
                "type": [
                  "number",
                  "string",
                  "boolean",
                  "null"
                ]
              },
              "excludedRows": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "finalComponents": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/numberOrNull"
          }
        },
        "output": {
          "$ref": "#/$defs/numberOrNull"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "dataState",
        "reason",
        "period"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/numberOrNull"
        },
        "dataState": {
          "$ref": "#/$defs/metricState"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "period": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "dataState",
        "reason",
        "horizon",
        "methodId",
        "change"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/numberOrNull"
        },
        "dataState": {
          "enum": [
            "available",
            "not-calculated",
            "insufficient",
            "unavailable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "horizon": {
          "type": [
            "string",
            "null"
          ]
        },
        "methodId": {
          "type": [
            "string",
            "null"
          ]
        },
        "change": {
          "$ref": "#/$defs/numberOrNull"
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kpiId",
        "current",
        "previous",
        "change",
        "changeUnit",
        "forecast",
        "target",
        "status"
      ],
      "properties": {
        "kpiId": {
          "type": "string",
          "minLength": 1
        },
        "current": {
          "$ref": "#/$defs/measurement"
        },
        "previous": {
          "$ref": "#/$defs/measurement"
        },
        "change": {
          "$ref": "#/$defs/numberOrNull"
        },
        "changeUnit": {
          "type": "string",
          "minLength": 1
        },
        "forecast": {
          "$ref": "#/$defs/forecast"
        },
        "target": {
          "$ref": "#/$defs/numberOrNull"
        },
        "status": {
          "enum": [
            "good",
            "warning",
            "neutral"
          ]
        }
      }
    }
  }
}
