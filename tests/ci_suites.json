{
  "version": 1,
  "suites": {
    "fast": {
      "description": "Python unit tests and focused JavaScript regressions for pull requests.",
      "python": [
        [
          "-m",
          "compileall",
          "-q",
          "src/python"
        ],
        [
          "-m",
          "unittest",
          "discover",
          "-s",
          "tests",
          "-p",
          "test_*.py"
        ]
      ],
      "javascript": [
        "tests/test_journal_category_monitor.js",
        "tests/test_journal_category_ui.js",
        "tests/test_journal_export_ui.js",
        "tests/test_journal_filters_ui.js",
        "tests/test_journal_integration_lifecycle.js",
        "tests/test_journal_operation_coverage.js",
        "tests/test_journal_operation_summary.js",
        "tests/test_journal_operation_summary_ui.js",
        "tests/test_ktg.js",
        "tests/test_kpi_catalog.js",
        "tests/test_kpi_report_view_model.js"
      ]
    }
  }
}
